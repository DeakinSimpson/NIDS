{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                // -- add includes folders --
                "-I${workspaceFolder}/include",

                "-pedantic-errors",
                // -- use debug more --
                /*
                change to for release:
                    "-O2",
                    "-DNDEBUG",
                */
                "-ggdb",
                // -- add extra warnings --
                "-Wall",
                "-Weffc++",
                "-Wextra",
                "-Wconversion",
                "-Wsign-conversion",
                // -- treat warnings as errors --
                "-Werror",
                // -- set the c++ compilter version
                "-std=c++26",

                /* -- what files to compile --
                 * ${file}: compiles just the file that is being run
                 * 
                 * ${fileDirname}\\**.cpp is all files in the directory of
                 * the file that is being run however does not include sub
                 * directories
                 */
                "${workspaceFolder}/src/*.cpp",
                "-o",
                "${workspaceFolder}/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}
